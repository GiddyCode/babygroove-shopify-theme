<section class="bg-promotion bg-art-section bg-art--bundle{% if section.settings.reverse %} bg-promotion--reverse{% endif %}" aria-labelledby="PromotionHeading-{{ section.id }}">
  <div class="bg-promotion__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 55vw, 100vw' }}{% else %}<div class="bg-placeholder">{{ 'product-4' | placeholder_svg_tag }}</div>{% endif %}</div>
  <div class="bg-promotion__content">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="PromotionHeading-{{ section.id }}">{{ section.settings.heading | default: section.settings.product.title | escape }}</h2>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}{% if section.blocks.size > 0 %}<ul class="bg-benefits">{% for block in section.blocks %}{% if block.settings.text != blank %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endif %}{% endfor %}</ul>{% endif %}{% if section.settings.product != blank %}<div class="bg-promotion__price">{% render 'price', product: section.settings.product, use_variant: true, show_badges: false %}</div>{% endif %}{% if section.settings.badge != blank %}<p><strong>{{ section.settings.badge | escape }}</strong></p>{% endif %}{% if section.settings.button_label != blank %}<div class="bg-button-row"><a class="bg-cta" href="{{ section.settings.product.url | default: section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a></div>{% endif %}</div>
</section>
{% schema %}
{"name":"Featured promotion","tag":"section","class":"section","max_blocks":4,"settings":[{"type":"product","id":"product","label":"Bundle product"},{"type":"image_picker","id":"image","label":"Optional replacement image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BabyGroove essentials"},{"type":"text","id":"heading","label":"Heading","default":"New Beginnings Starter Bundle"},{"type":"richtext","id":"text","label":"Description"},{"type":"text","id":"badge","label":"Optional factual badge"},{"type":"text","id":"button_label","label":"Button","default":"Shop the Bundle"},{"type":"url","id":"button_link","label":"Fallback link"},{"type":"checkbox","id":"reverse","label":"Image on right","default":true}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"text","label":"Text"}]}],"presets":[{"name":"Featured promotion","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]}
{% endschema %}
