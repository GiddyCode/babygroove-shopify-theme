<section class="bg-home-section bg-home-section--{{ section.settings.tone }}" aria-labelledby="ValuesHeading-{{ section.id }}">
  <div class="bg-home__inner"><header class="bg-section-head">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="ValuesHeading-{{ section.id }}" class="bg-section-title">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="bg-section-copy rte">{{ section.settings.text }}</div>{% endif %}</header>
  <div class="bg-values-grid">{% for block in section.blocks %}<article class="bg-value" {{ block.shopify_attributes }}><div class="bg-value__icon" style="--tile:{{ block.settings.accent }}">{% case block.settings.icon %}{% when 'leaf' %}{{ 'icon-leaf.svg' | inline_asset_content }}{% when 'truck' %}{{ 'icon-truck.svg' | inline_asset_content }}{% when 'return' %}{{ 'icon-return.svg' | inline_asset_content }}{% when 'lock' %}{{ 'icon-lock.svg' | inline_asset_content }}{% else %}{{ 'icon-heart.svg' | inline_asset_content }}{% endcase %}</div><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}</article>{% endfor %}</div></div>
</section>
{% schema %}
{"name":"Trust and values","tag":"section","class":"section","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A happier, brighter tomorrow"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtfully chosen. Always for them."},{"type":"richtext","id":"text","label":"Text"},{"type":"select","id":"tone","label":"Background","default":"mist","options":[{"value":"white","label":"White"},{"value":"mist","label":"Pastel mist"},{"value":"mint","label":"Mint"}]}],"blocks":[{"type":"value","name":"Value","settings":[{"type":"select","id":"icon","label":"Icon","default":"heart","options":[{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"truck","label":"Truck"},{"value":"return","label":"Returns"},{"value":"lock","label":"Lock"}]},{"type":"color","id":"accent","label":"Icon background","default":"#FDE3E8"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtfully selected"},{"type":"richtext","id":"text","label":"Text"}]}],"presets":[{"name":"Trust and values","blocks":[{"type":"value"},{"type":"value"},{"type":"value"},{"type":"value"}]}]}
{% endschema %}
