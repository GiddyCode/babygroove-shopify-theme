<section class="bg-home-section bg-home-section--white" aria-labelledby="CommunityHeading-{{ section.id }}"><div class="bg-home__inner"><header class="bg-section-head">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="CommunityHeading-{{ section.id }}" class="bg-section-title">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="bg-section-copy rte">{{ section.settings.text }}</div>{% endif %}</header>{% if section.blocks.size > 0 %}<div class="bg-community-grid" role="list">{% for block in section.blocks %}<a class="bg-community-card" href="{{ block.settings.link | default: section.settings.button_link | default: routes.root_url }}" role="listitem" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300,500,700', sizes: '(min-width: 900px) 20vw, 70vw' }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}{% if block.settings.caption != blank %}<span>{{ block.settings.caption | escape }}</span>{% endif %}</a>{% endfor %}</div>{% endif %}{% if section.settings.button_label != blank %}<div class="bg-button-row" style="justify-content:center"><a class="bg-cta" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a></div>{% endif %}</div></section>
{% schema %}
{"name":"Community journey","tag":"section","class":"section","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Little moments. Big happiness."},{"type":"text","id":"heading","label":"Heading","default":"Follow our journey"},{"type":"richtext","id":"text","label":"Text","default":"<p>A place for real family moments and BabyGroove stories.</p>"},{"type":"text","id":"button_label","label":"Social button"},{"type":"url","id":"button_link","label":"Social link"}],"blocks":[{"type":"tile","name":"Image tile","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Community journey","blocks":[{"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"},{"type":"tile"}]}]}
{% endschema %}
