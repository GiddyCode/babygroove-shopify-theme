<section class="bg-hero bg-home-section" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="bg-hero__grid bg-home__inner">
    <div class="bg-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 id="HeroHeading-{{ section.id }}" class="bg-hero__title">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {% if section.settings.text != blank %}<div class="bg-hero__text rte">{{ section.settings.text }}</div>{% endif %}
      <div class="bg-button-row">
        {% if section.settings.button_label != blank %}<a class="bg-cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
        {% if section.settings.button_label_2 != blank %}<a class="bg-cta bg-cta--secondary" href="{{ section.settings.button_link_2 | default: routes.root_url }}">{{ section.settings.button_label_2 | escape }}</a>{% endif %}
      </div>
    </div>
    <div class="bg-hero__media">
      {% if section.settings.image != blank %}
        <picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '750,1100,1500,1800', sizes: '(min-width: 900px) 55vw, 100vw', fetchpriority: 'high' }}</picture>
      {% else %}<div class="bg-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}
    </div>
  </div>
  <span class="bg-doodle bg-doodle--one" aria-hidden="true">☆</span><span class="bg-doodle bg-doodle--two" aria-hidden="true">♡</span>
</section>
{% schema %}
{"name":"BabyGroove hero","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Happy Little Humans"},{"type":"textarea","id":"heading","label":"Heading","default":"Little Moments.\nBig Tomorrows."},{"type":"richtext","id":"text","label":"Text","default":"<p>Thoughtfully chosen essentials for all the beautiful little moments in between.</p>"},{"type":"text","id":"button_label","label":"Primary button","default":"Shop new arrivals"},{"type":"url","id":"button_link","label":"Primary link"},{"type":"text","id":"button_label_2","label":"Secondary button","default":"Explore BabyGroove"},{"type":"url","id":"button_link_2","label":"Secondary link"}],"presets":[{"name":"BabyGroove hero"}]}
{% endschema %}
