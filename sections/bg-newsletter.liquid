<section class="bg-newsletter bg-art-section bg-art--newsletter" aria-labelledby="NewsletterHeading-{{ section.id }}">
  <div class="bg-newsletter__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 900px) 50vw, 100vw' }}{% else %}<div class="bg-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>{% endif %}</div>
  <div class="bg-newsletter__content">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="NewsletterHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    {% form 'customer', class: 'newsletter-form bg-newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><div class="bg-newsletter-control"><label class="visually-hidden" for="NewsletterForm-{{ section.id }}">{{ 'newsletter.label' | t }}</label><input id="NewsletterForm-{{ section.id }}" type="email" name="contact[email]" class="bg-newsletter-control__input" value="{{ form.email }}" aria-required="true" autocorrect="off" autocapitalize="off" autocomplete="email" {% if form.errors %}aria-invalid="true" aria-describedby="Newsletter-error-{{ section.id }}"{% elsif form.posted_successfully? %}aria-describedby="Newsletter-success-{{ section.id }}"{% endif %} placeholder="Enter your email address" required><button type="submit" class="bg-newsletter-control__button" name="commit"><span>{{ section.settings.button_label | escape }}</span><span aria-hidden="true">→</span></button></div>{% if form.errors %}<small class="newsletter-form__message form__message" id="Newsletter-error-{{ section.id }}">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</small>{% endif %}{% if form.posted_successfully? %}<h3 class="newsletter-form__message newsletter-form__message--success form__message" id="Newsletter-success-{{ section.id }}" tabindex="-1" autofocus>{{ 'newsletter.success' | t }}</h3>{% endif %}{% endform %}
    {% if section.blocks.size > 0 %}<ul class="bg-newsletter-benefits" role="list">{% for block in section.blocks %}{% if block.settings.text != blank %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endif %}{% endfor %}</ul>{% endif %}
    {% if section.settings.note != blank %}<small>{{ section.settings.note | escape }}</small>{% endif %}
  </div>
</section>
{% schema %}
{"name":"BabyGroove newsletter","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Optional replacement image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Little updates. Big smiles."},{"type":"text","id":"heading","label":"Heading","default":"Join the BabyGroove Family"},{"type":"richtext","id":"text","label":"Text","default":"<p>Be the first to know about new arrivals, exclusive offers, parenting tips, and more.</p>"},{"type":"text","id":"button_label","label":"Button","default":"Subscribe"},{"type":"text","id":"note","label":"Note","default":"No spam. Just the good stuff."}],"presets":[{"name":"BabyGroove newsletter"}]}
{% endschema %}
