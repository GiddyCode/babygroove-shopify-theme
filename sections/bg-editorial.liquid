<section class="bg-editorial bg-art-section bg-art--editorial{% if section.settings.reverse %} bg-editorial--reverse{% endif %}" aria-labelledby="EditorialHeading-{{ section.id }}">
  <div class="bg-editorial__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 55vw, 100vw' }}{% else %}<div class="bg-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>{% endif %}</div>
  <div class="bg-editorial__content">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="EditorialHeading-{{ section.id }}">{{ section.settings.heading | escape | newline_to_br }}</h2>{% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}{% if section.settings.button_label != blank %}<div class="bg-button-row"><a class="bg-cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a></div>{% endif %}</div>
</section>
{% schema %}
{"name":"Lifestyle editorial","tag":"section","class":"section","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Real moments. Brighter days."},{"type":"textarea","id":"heading","label":"Heading","default":"For the little\nbig adventures."},{"type":"richtext","id":"text","label":"Text","default":"<p>Essentials for every milestone, thoughtfully chosen for your family.</p>"},{"type":"text","id":"button_label","label":"Button","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Link"},{"type":"checkbox","id":"reverse","label":"Image on right","default":false}],"presets":[{"name":"Lifestyle editorial"}]}
{% endschema %}
