<section class="bg-home-section bg-art-section bg-art--categories bg-category-discovery" aria-labelledby="CategoryHeading-{{ section.id }}">
  <div class="bg-home__inner">
    <header class="bg-section-head bg-category-discovery__head">
      {%- if section.settings.eyebrow != blank -%}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="CategoryHeading-{{ section.id }}" class="bg-section-title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="bg-section-copy rte">{{ section.settings.text }}</div>{%- endif -%}
    </header>

    <nav class="bg-category-grid" aria-label="{{ section.settings.category_label | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- liquid
            assign target = block.settings.collection
            assign tile_url = target.url | default: block.settings.link | default: routes.all_products_collection_url
            assign tile_title = block.settings.title | default: target.title
            case block.settings.default_art
              when 'nursery'
                assign default_asset = 'bg-category-nursery.png'
              when 'feeding'
                assign default_asset = 'bg-category-feeding.png'
              when 'diapering'
                assign default_asset = 'bg-category-diapering.png'
              when 'clothing'
                assign default_asset = 'bg-category-clothing.png'
              when 'toys-play'
                assign default_asset = 'bg-category-toys-play.png'
              when 'bath-care'
                assign default_asset = 'bg-category-bath-care.png'
              when 'on-the-go'
                assign default_asset = 'bg-category-on-the-go.png'
              else
                assign default_asset = 'bg-category-gifts.png'
            endcase
          -%}
          <a class="bg-category" href="{{ tile_url }}" aria-label="{{ tile_title | escape }}" {{ block.shopify_attributes }}>
            <span class="bg-category__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '180,260,360,500', sizes: '(min-width: 1200px) 13rem, (min-width: 750px) 18vw, 22vw', alt: tile_title }}
              {%- else -%}
                <img src="{{ default_asset | asset_url }}" alt="" width="1254" height="1254" loading="lazy">
              {%- endif -%}
            </span>
            <span class="bg-category__title">{{ tile_title | escape }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="bg-category-promos" aria-label="{{ section.settings.promo_label | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'promotion' -%}
          {%- liquid
            assign promo_target = block.settings.collection
            assign promo_url = promo_target.url | default: block.settings.link | default: routes.all_products_collection_url
            case block.settings.default_art
              when 'play-grow'
                assign promo_asset = 'bg-category-card-play-grow.png'
              when 'sustainable'
                assign promo_asset = 'bg-category-card-sustainable.png'
              when 'new-season'
                assign promo_asset = 'bg-category-card-new-season.png'
              else
                assign promo_asset = 'bg-category-card-cozy-spaces.png'
            endcase
          -%}
          <article class="bg-category-promo bg-category-promo--{{ block.settings.tone }}" {{ block.shopify_attributes }}>
            <div class="bg-category-promo__media" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,750,1000,1200', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 92vw', alt: '' }}
              {%- else -%}
                <img src="{{ promo_asset | asset_url }}" alt="" width="1672" height="941" loading="lazy">
              {%- endif -%}
            </div>
            <div class="bg-category-promo__content">
              <h3><span>{{ block.settings.heading | escape }}</span>{% if block.settings.heading_2 != blank %}<span>{{ block.settings.heading_2 | escape }}</span>{% endif %}</h3>
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
              {%- if block.settings.button_label != blank -%}<a class="bg-category-promo__cta" href="{{ promo_url }}">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category discovery",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Essentials for Every Adventure" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtfully chosen for every stage of your little one’s journey.</p>" },
    { "type": "text", "id": "category_label", "label": "Category list accessibility label", "default": "Shop by category" },
    { "type": "text", "id": "promo_label", "label": "Promotion list accessibility label", "default": "Explore BabyGroove collections" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "select", "id": "default_art", "label": "Default artwork", "default": "nursery", "options": [
          { "value": "nursery", "label": "Nursery" }, { "value": "feeding", "label": "Feeding" },
          { "value": "diapering", "label": "Diapering" }, { "value": "clothing", "label": "Clothing" },
          { "value": "toys-play", "label": "Toys & Play" }, { "value": "bath-care", "label": "Bath & Care" },
          { "value": "on-the-go", "label": "On the Go" }, { "value": "gifts", "label": "Gifts" }
        ] },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    },
    {
      "type": "promotion",
      "name": "Discovery card",
      "settings": [
        { "type": "select", "id": "default_art", "label": "Default artwork", "default": "cozy-spaces", "options": [
          { "value": "cozy-spaces", "label": "Cozy Spaces" }, { "value": "play-grow", "label": "Play & Grow" },
          { "value": "sustainable", "label": "Sustainable" }, { "value": "new-season", "label": "New Season" }
        ] },
        { "type": "select", "id": "tone", "label": "Button tone", "default": "pink", "options": [
          { "value": "pink", "label": "Pink" }, { "value": "mint", "label": "Mint" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Discover more" },
        { "type": "text", "id": "heading_2", "label": "Heading line 2" },
        { "type": "richtext", "id": "text", "label": "Body" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [{
    "name": "Category discovery",
    "blocks": [
      { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" },
      { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" },
      { "type": "promotion" }, { "type": "promotion" }, { "type": "promotion" }, { "type": "promotion" }
    ]
  }]
}
{% endschema %}
