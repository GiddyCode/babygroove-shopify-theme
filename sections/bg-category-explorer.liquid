<section class="bg-home-section bg-art-section bg-art--categories" aria-labelledby="CategoryHeading-{{ section.id }}">
  <div class="bg-home__inner">
    <header class="bg-section-head">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="CategoryHeading-{{ section.id }}" class="bg-section-title">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="bg-section-copy rte">{{ section.settings.text }}</div>{% endif %}</header>
    <div class="bg-category-grid">
      {% for block in section.blocks %}
        {% liquid
          assign target = block.settings.collection
          assign tile_image = block.settings.image | default: target.featured_image
          assign tile_url = target.url | default: block.settings.link | default: routes.all_products_collection_url
          assign tile_title = block.settings.title | default: target.title
        %}
        <a class="bg-category" href="{{ tile_url }}" {{ block.shopify_attributes }}><div class="bg-category__media" style="--tile:{{ block.settings.accent }}">{% if tile_image != blank %}{{ tile_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '220,350,500', sizes: '(min-width: 900px) 12vw, 42vw' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div><h3 class="bg-category__title">{{ tile_title | escape }}</h3><span class="bg-round-arrow" aria-hidden="true">→</span></a>
      {% endfor %}
    </div>
    {% if section.settings.button_label != blank %}<div class="bg-button-row" style="justify-content:center"><a class="bg-cta" href="{{ section.settings.button_link | default: routes.collections_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a></div>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Category explorer","tag":"section","class":"section","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Everything for their next chapter"},{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"},{"type":"richtext","id":"text","label":"Text","default":"<p>Discover thoughtfully chosen products for every little moment.</p>"},{"type":"text","id":"button_label","label":"Button","default":"Explore all collections"},{"type":"url","id":"button_link","label":"Link"}],"blocks":[{"type":"category","name":"Category","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Custom image"},{"type":"text","id":"title","label":"Custom title"},{"type":"url","id":"link","label":"Custom link"},{"type":"color","id":"accent","label":"Accent","default":"#FDE3E8"}]}],"presets":[{"name":"Category explorer","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}]}
{% endschema %}
