<section class="bg-home-section bg-art-section bg-art--why" aria-labelledby="BrandHeading-{{ section.id }}"><div class="bg-home__inner"><header class="bg-section-head">{% if section.settings.eyebrow != blank %}<p class="bg-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="BrandHeading-{{ section.id }}" class="bg-section-title">{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div class="bg-section-copy rte">{{ section.settings.text }}</div>{% endif %}</header><div class="bg-brand-grid">{% for block in section.blocks %}<article class="bg-brand-card" {{ block.shopify_attributes }}><div class="bg-value__icon" style="--tile:{{ block.settings.accent }}">{% case block.settings.icon %}{% when 'leaf' %}{{ 'icon-leaf.svg' | inline_asset_content }}{% when 'truck' %}{{ 'icon-truck.svg' | inline_asset_content }}{% when 'lock' %}{{ 'icon-lock.svg' | inline_asset_content }}{% else %}{{ 'icon-heart.svg' | inline_asset_content }}{% endcase %}</div><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}</article>{% endfor %}</div>{% if section.settings.button_label != blank %}<div class="bg-button-row" style="justify-content:center"><a class="bg-cta" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>{% endif %}</div></section>
{% schema %}
{"name":"Why BabyGroove","tag":"section","class":"section","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Why BabyGroove"},{"type":"text","id":"heading","label":"Heading","default":"More than just a store"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"button_label","label":"Optional button"},{"type":"url","id":"button_link","label":"Button link"}],"blocks":[{"type":"value","name":"Brand value","settings":[{"type":"select","id":"icon","label":"Icon","default":"heart","options":[{"value":"heart","label":"Heart"},{"value":"leaf","label":"Leaf"},{"value":"truck","label":"Truck"},{"value":"lock","label":"Lock"}]},{"type":"color","id":"accent","label":"Accent","default":"#E3F3EF"},{"type":"text","id":"heading","label":"Heading","default":"Our value"},{"type":"richtext","id":"text","label":"Text"}]}],"presets":[{"name":"Why BabyGroove","blocks":[{"type":"value"},{"type":"value"},{"type":"value"},{"type":"value"}]}]}
{% endschema %}
